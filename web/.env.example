# --- MYCERRA Agent OS environment ---
# Local-first MVP. Copy this file to `.env` and adjust values.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mycerra?schema=public"

# Admin-only authentication.
# The single owner/admin password used to sign in.
ADMIN_PASSWORD="change-me-locally"

# Secret used to sign the admin session cookie. Use a long random string.
AUTH_SECRET="please-generate-a-long-random-secret-string"
