// MYCERRA Agent OS — Prisma schema
// Local-first internal command center for SAVE EARTH Inc.
//
// Business rules encoded here:
//  - Confidential product/IP info is flagged (`confidential`) and never auto-exposed.
//  - Sample requests are NEVER auto-approved (ownerApproved defaults false).
//  - Proposals & content require owner approval before being external-ready.
//  - Risk classification is one of Green / Yellow / Red / Black.
//  - Black-level info is blocked from external-facing drafts (blockedFromExternal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OfferStatus {
  ACTIVE
  DRAFT
  PAUSED
  ARCHIVED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum SampleStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED_PENDING_SHIPMENT
  SHIPPED
  REJECTED
  CLOSED
}

enum ProposalType {
  SAMPLE_REVIEW
  SAMPLE_BOOK
  PAID_POC
  WADIZ_REWARD
  GLOBAL_SAMPLE
  CONSULTING
  LICENSING
  OTHER
}

enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  OWNER_APPROVAL_REQUIRED
  APPROVED
  SENT
  ACCEPTED
  DECLINED
}

enum ContentChannel {
  WADIZ
  BLOG
  SNS
  EMAIL
  PRESS
  WEBSITE
  OTHER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  OWNER_APPROVAL_REQUIRED
  APPROVED
  PUBLISHED_MANUAL
  ARCHIVED
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
  BLACK
}

enum WadizStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  READY
  DONE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Product {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  category     String?
  description  String?
  status       ProductStatus @default(ACTIVE)
  // True for Pure Mat / licensing / production-condition bearing records.
  // Confidential records must never be placed verbatim in external drafts.
  confidential Boolean       @default(false)
  priceNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offers Offer[]

  @@index([status])
}

model Offer {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        String?
  description String?
  priceModel  String?
  status      OfferStatus @default(ACTIVE)
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  proposals      Proposal[]
  sampleRequests SampleRequest[]

  @@index([status])
}

model Lead {
  id          String    @id @default(cuid())
  company     String
  contactName String?
  email       String?
  phone       String?
  country     String?
  segment     String?
  source      String?
  stage       LeadStage @default(NEW)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sampleRequests SampleRequest[]
  proposals      Proposal[]

  @@index([stage])
}

model SampleRequest {
  id              String       @id @default(cuid())
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  offerId         String?
  offer           Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  company         String?
  contactName     String?
  sampleType      String?
  quantity        Int          @default(1)
  shippingAddress String?
  status          SampleStatus @default(REQUESTED)
  // Sample requests are NEVER auto-approved. Owner must explicitly approve.
  ownerApproved   Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
}

model Proposal {
  id       String         @id @default(cuid())
  title    String
  leadId   String?
  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  offerId  String?
  offer    Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  type     ProposalType   @default(OTHER)
  amount   Decimal?       @db.Decimal(12, 2)
  currency String         @default("KRW")
  status   ProposalStatus @default(DRAFT)
  content  String?
  // Risk review must pass before a proposal may go external.
  riskChecked   Boolean   @default(false)
  // Set to true only after explicit owner approval. Drives external readiness.
  ownerApproved Boolean   @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model ContentDraft {
  id       String         @id @default(cuid())
  title    String
  channel  ContentChannel @default(OTHER)
  body     String?
  status   ContentStatus  @default(DRAFT)
  // Highest risk level detected in this draft (from risk review).
  riskLevel RiskLevel     @default(GREEN)
  riskChecked      Boolean @default(false)
  // The app NEVER auto-publishes. Owner approval is required and manual.
  ownerApproved    Boolean @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}

model RiskReview {
  id             String    @id @default(cuid())
  phrase         String
  classification RiskLevel
  category       String?
  rationale      String?
  // Free-form reference to the entity this phrase was reviewed for.
  linkedType     String?
  linkedId       String?
  // Black (and by policy Red awaiting approval) is blocked from external drafts.
  blockedFromExternal Boolean @default(false)
  reviewedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([classification])
}

model WadizItem {
  id        String      @id @default(cuid())
  title     String
  taskType  String?
  status    WadizStatus @default(BACKLOG)
  owner     String?
  dueDate   DateTime?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
